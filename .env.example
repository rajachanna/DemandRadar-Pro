# Generate a unique key; never commit your real key.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DR_OPERATOR_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_24_CHARACTERS
DR_DB_PATH=./data/demandradar.sqlite
DR_DEMO_MODE=false
